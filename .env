BOT_TOKEN=123456:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALLOWED_USER_IDS=
FORCE_JOIN_CHANNEL=

API_BASE_URL=https://thescholarverse.in
API_PREFIX=/api
API_KEY=
API_KEY_HEADER=X-API-Key
API_REFERER=https://thescholarverse.in/
API_TIMEOUT=40
API_CACHE_TTL=300
API_MOCK=1

BRAND_NAME=TheScholarVerse.In
BRAND_URL=https://thescholarverse.in
BRAND_CHANNEL=@TheScholarVerse
BRAND_SUPPORT=@TheScholarVerseSupport
BRAND_TAGLINE=Padho. Download karo. Aage badho.
BRAND_LOGO=assets/logo.png

WORK_DIR=/tmp/scholarverse
MAX_UPLOAD_MB=50
MAX_FILE_MB=2000
CONCURRENT_DOWNLOADS=3
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
KEEP_FILES=0

PAGE_SIZE=8
LOG_LEVEL=INFO
